#!/bin/bash

set -euo pipefail

METADATA_TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')"
REGION="$(curl -fsS -H "X-aws-ec2-metadata-token: ${METADATA_TOKEN}" \
  http://169.254.169.254/latest/meta-data/placement/region)"
export AWS_DEFAULT_REGION="${REGION}"

download_key() {
  local key_name="$1"
  local key_path="/home/${AMI_EC2_DEFAULT_USER}/${key_name}.pem"

  aws s3 cp "s3://${AUTHIFY_S3_PEM_BUCKET}/${key_name}.pem" "${key_path}" --no-cli-pager
  chmod 400 "${key_path}"
  chown "${AMI_EC2_DEFAULT_USER}:${AMI_EC2_DEFAULT_USER}" "${key_path}"
  aws s3 rm "s3://${AUTHIFY_S3_PEM_BUCKET}/${key_name}.pem" >/dev/null 2>&1 || true
}

AUTHIFY_S3_PEM_BUCKET="$(required_ssm_parameter /authify/s3/bucket/pem)"

download_key "${EC2_API_GATEWAY_KEY_NAME}"
download_key "${EC2_AUTHIFY_SERVICE_KEY_NAME}"

echo "Bastion host keys downloaded."
